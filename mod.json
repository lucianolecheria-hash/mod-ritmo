{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081"
	},
	"version": "1.0.0",
	"id": "luchx.barra-ritmo-final",
	"name": "Rhythm Practice Bar",
	"developer": "LuchX20",
	"description": "Barra de ritmo horizontal con indicador de precisión (Perfecto/Fallo) y biblioteca de macros.",
	"tags": ["interface", "utility"],
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"macro-file": {
			"type": "string",
			"name": "Archivo de macro",
			"description": "Ruta de la macro nativa .gdr2",
			"default": "macro.gdr2"
		},
		"bar-width": {
			"type": "int",
			"name": "Largo de la barra (% de pantalla)",
			"default": 60,
			"min": 10,
			"max": 100,
			"control": { "slider": true }
		},
		"bar-height": {
			"type": "int",
			"name": "Grosor de la barra (px)",
			"default": 44,
			"min": 16,
			"max": 120,
			"control": { "slider": true }
		},
		"bg-opacity": {
			"type": "int",
			"name": "Opacidad del fondo (%)",
			"default": 35,
			"min": 0,
			"max": 100,
			"control": { "slider": true }
		}
	}
}
