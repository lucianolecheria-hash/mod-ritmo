{
	"geode": "5.0.0-beta.1",
	"gd": {
		"win": "2.2081"
	},
	"version": "1.0.0",
	"id": "luchx.barra-ritmo-final",
	"name": "Rhythm Practice Bar",
	"developer": "LuchX20",
	"description": "Barra de ritmo vertical (estilo guitar hero) para practicar el timing de clics a partir de una macro de texto.",
	"tags": ["interface", "utility"],
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Activado",
			"description": "Muestra la barra de ritmo dentro de los niveles.",
			"default": true
		},
		"macro-file": {
			"type": "string",
			"name": "Archivo de macro",
			"description": "Ruta del .txt con los tiempos. Si es relativa, se busca en la carpeta de guardado del mod.",
			"default": "macro.txt"
		},
		"side": {
			"type": "string",
			"name": "Lado de la pantalla",
			"default": "Derecha",
			"one-of": ["Derecha", "Izquierda"]
		},
		"direction": {
			"type": "string",
			"name": "Dirección de las notas",
			"description": "Bajan o suben hacia el receptor.",
			"default": "Bajan",
			"one-of": ["Bajan", "Suben"]
		},
		"bar-width": {
			"type": "int",
			"name": "Ancho de la barra (px)",
			"default": 34,
			"min": 16,
			"max": 120,
			"control": { "input": true, "slider": true }
		},
		"bar-height": {
			"type": "int",
			"name": "Alto de la barra (%)",
			"default": 70,
			"min": 30,
			"max": 95,
			"control": { "input": true, "slider": true }
		},
		"lookahead": {
			"type": "float",
			"name": "Anticipación (segundos)",
			"default": 1.5,
			"min": 0.5,
			"max": 5.0,
			"control": { "input": true, "slider": true }
		},
		"tap-threshold": {
			"type": "int",
			"name": "Umbral de clic único (ms)",
			"default": 120,
			"min": 0,
			"max": 500,
			"control": { "input": true, "slider": true }
		},
		"offset": {
			"type": "int",
			"name": "Desfase de sincronización (ms)",
			"default": 0,
			"min": -500,
			"max": 500,
			"control": { "input": true, "slider": true }
		},
		"bg-opacity": {
			"type": "int",
			"name": "Opacidad del fondo (%)",
			"default": 35,
			"min": 0,
			"max": 100,
			"control": { "input": true, "slider": true }
		}
	}
}
